<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sección propia dentro de Ajustes. Se usa la vista estándar de Ajustes
         porque su botón Guardar llama a execute(), que es lo que escribe el
         color en ir.config_parameter y recarga la página. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.color.ui</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Color de la interfaz" string="Color de la interfaz"
                     name="odoo19uicolorchange" groups="base.group_system">
                    <block title="Color de la interfaz" name="odoo19uicolorchange_block">
                        <setting string="Color de marca"
                                 help="Código hexadecimal (por ejemplo #b51f23). Se aplica a la barra superior, los botones principales, las facetas del buscador y el menú de aplicaciones.">
                            <field name="brand_color" placeholder="#b51f23"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_color_ui_config" model="ir.actions.act_window">
        <field name="name">Color de la interfaz</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'odoo19uicolorchange', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_color_ui_config"
              name="Color de la interfaz"
              parent="base.menu_administration"
              action="action_color_ui_config"
              groups="base.group_system"
              sequence="90"/>

</odoo>
